---
import { getLanguages } from "@/lib/loaders";
import Section from "../section.astro";

const { data: languages } = await getLanguages();
---

<Section
  label="Languages"
  class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-12 [&>h2]:col-span-full"
>
  {
    languages.map((language) => (
      <article class="col-span-full mt-1 grid grid-cols-subgrid items-center">
        <h3 class="font-bold uppercase">{language.language}</h3>
        <span class="text-sm">{language.level}</span>
      </article>
    ))
  }
</Section>

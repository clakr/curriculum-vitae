---
import { getCertifications } from "@/lib/loaders";

const { data: certifications } = await getCertifications();
---

<section>
  <h2>CERTIFICATIONS</h2>
  {
    certifications.map((certification) => (
      <article class="py-4">
        <h3>{certification.name}</h3>
        <span>{certification.attained}</span>
        <span>{certification.issued_by}</span>
      </article>
    ))
  }
</section>

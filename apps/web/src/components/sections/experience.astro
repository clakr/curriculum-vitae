---
import { getCompanies } from "@/lib/loaders";
import Section from "@/components/section.astro";

const { data: companies } = await getCompanies();

const dateFormatter = new Intl.DateTimeFormat(undefined, {
  month: "long",
  year: "numeric",
});

function formatDate(from: string, to: string | null) {
  return [from, to]
    .map((date) => {
      if (date === null) return "Present";

      return dateFormatter.format(new Date(date));
    })
    .join(" - ");
}
---

<Section label="Experience" class="">
  {
    companies.map((company) => (
      <article class="@container mt-8 flex flex-col gap-y-4">
        <div class="flex flex-col">
          <div class="flex flex-col gap-x-1 @md:flex-row">
            <h3 class="font-extrabold">{company.organization.name}</h3>
            <span class="hidden @md:block">–</span>
            <span>{company.organization.location}</span>
          </div>
          <span>
            {formatDate(company.organization.from, company.organization.to)}
          </span>
        </div>
        {company.experiences.map((experience) => (
          <div class="flex flex-col gap-y-1">
            <h4 class="font-bold">{experience.position}</h4>
            <ul class="flex list-inside list-disc flex-col gap-y-1 text-sm">
              {experience.responsibilities.map(({ item: responsibility }) => (
                <li>{responsibility}</li>
              ))}
            </ul>
          </div>
        ))}
      </article>
    ))
  }
</Section>

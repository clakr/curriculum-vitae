---
import { getEducations } from "@/lib/loaders";
import Section from "../section.astro";

const { data: educations } = await getEducations();
---

<Section label="Education">
  {
    educations.map((education) => (
      <article>
        <h3>{education.course}</h3>
        <span>
          {education.school.organization.from} -{" "}
          {education.school.organization.to}
        </span>
        <span>{education.school.organization.name}</span>
        <span>{education.school.organization.location}</span>
      </article>
    ))
  }
</Section>

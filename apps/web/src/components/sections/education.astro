---
import { getEducations } from "@/lib/loaders";
import Section from "../section.astro";
import { formatDuration } from "@/lib/utils";

const { data: educations } = await getEducations();
---

<Section label="Education" class="@container">
  {
    educations.map((education) =>
      education.school && education.school.organization ? (
        <article class="max-w-read grid gap-x-4 @lg:grid-cols-[minmax(0,1fr)_auto]">
          <h3 class="font-bold">{education.course}</h3>
          <span>
            {formatDuration({
              from: education.school.organization.from,
              to: education.school.organization.to,
              options: {
                month: undefined,
              },
            })}
          </span>
          <span>{education.school.organization.name}</span>
          <span>{education.school.organization.location}</span>
        </article>
      ) : null,
    )
  }
</Section>

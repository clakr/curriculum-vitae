---
import { getReferences } from "@/lib/loaders";
import Section from "../section.astro";

const { data: references } = await getReferences();
---

<Section label="References" class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] [&>h2]:col-span-full gap-4">
  {
    references.map((reference) => (
      <article class="mt-4 flex flex-col items-start text-sm">
        <h3 class="font-bold">
          {reference.name} — {reference.position}
        </h3>
        <span>{reference.company}</span>
        <!-- <div> -->
        <!--   {reference.email ? ( -->
        <!--     <> -->
        <!--       <a href={`mailto:${reference.email}`}>{reference.email}</a> -->
        <!--       <span>|</span> -->
        <!--     </> -->
        <!--   ) : null} -->
        <!--   <a href={`tel:${reference.phone_number}`}>{reference.phone_number}</a> -->
        <!-- </div> -->
        <span>Relationship: {reference.relationship}</span>
      </article>
    ))
  }
</Section>

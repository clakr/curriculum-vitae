---
import { getTechnicalSkills } from "@/lib/loaders";
import Section from "../section.astro";
import { listFormatter } from "@/lib/utils";

const { data: technicalSkills } = await getTechnicalSkills();

function formatSkills(skills: Array<{ id: string; item: string }>) {
  return listFormatter.format(skills.map((skill) => skill.item));
}
---

<Section
  label="Technical Skills"
  class="grid gap-x-12 lg:grid-cols-[auto_minmax(0,1fr)] [&>h2]:col-span-full"
>
  {
    technicalSkills.map((technicalSkill) => (
      <article class="col-span-full mt-6 grid grid-cols-subgrid items-center lg:mt-2">
        <h3 class="font-bold uppercase">{technicalSkill.category}</h3>
        <span class="text-sm">{formatSkills(technicalSkill.skills)}</span>
      </article>
    ))
  }
</Section>

---
import { getTechnicalSkills } from "@/lib/loaders";
import Section from "../section.astro";

const { data: technicalSkills } = await getTechnicalSkills();
---

<Section label="Technical Skills">
  {
    technicalSkills.map((technicalSkill) => (
      <article>
        <h3>{technicalSkill.category}</h3>
        <ul>
          {technicalSkill.skills.map(({ item: skill }) => (
            <li>{skill}</li>
          ))}
        </ul>
      </article>
    ))
  }
</Section>

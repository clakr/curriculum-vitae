---
import { getProjects } from "@/lib/loaders";
import Section from "../section.astro";
import { IconBrandGithub, IconExternalLink } from "@tabler/icons-react";
import { listFormatter } from "@/lib/utils";
import type {
  ArrayLinkComponent,
  ArrayListComponent,
} from "@/lib/strapi.types";

const { data: projects } = await getProjects();

function getLiveSiteLink(links: Array<ArrayLinkComponent>) {
  return links.find((link) => link.label === "Live Site");
}

function getGitHubLink(links: Array<ArrayLinkComponent>) {
  return links.find((link) => link.label === "GitHub");
}

function formatTechnicalStack(techStack: Array<ArrayListComponent>) {
  return listFormatter.format(techStack.map((skill) => skill.item));
}
---

<Section label="Projects">
  {
    projects.map((project) => (
      <article class="mt-4 text-sm">
        <div class="flex gap-x-2">
          <h3 class="flex items-center gap-x-2 text-base font-bold">
            {getLiveSiteLink(project.links) ? (
              <a
                target="_blank"
                href={getLiveSiteLink(project.links)?.href}
                class="flex gap-x-1"
              >
                {project.name}
                <IconExternalLink className="size-3 translate-y-[37.5%]" />
              </a>
            ) : (
              <span>{project.name}</span>
            )}

            {getGitHubLink(project.links) ? (
              <a target="_blank" href={getGitHubLink(project.links)?.href}>
                <span class="sr-only">Go to GitHub repository</span>
                <IconBrandGithub className="size-4" />
              </a>
            ) : null}
          </h3>
        </div>
        <p>{project.description}</p>
        <div>
          <span class="font-semibold">Tech Stack:</span>
          <span>{formatTechnicalStack(project.tech_stack)}</span>
        </div>
      </article>
    ))
  }
</Section>

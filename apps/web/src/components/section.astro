---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = {
  label: string;
} & HTMLAttributes<"section">;

const { label, class: className, ...rest } = Astro.props;
---

<section
  class={cn("flex flex-col [&>article:first-of-type]:mt-4", className)}
  {...rest}
>
  <h2 class="text-lg font-bold uppercase">{label}</h2>
  <slot />
</section>

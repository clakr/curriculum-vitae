---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = {
  label: string;
} & HTMLAttributes<"section">;

const { label, class: className, ...rest } = Astro.props;
---

<section class={cn("flex flex-col gap-y-8", className)} {...rest}>
  <h2 class="text-lg font-bold uppercase">{label}</h2>
  <slot />
</section>

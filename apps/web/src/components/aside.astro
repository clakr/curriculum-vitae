---
import { getInfos } from "@/lib/loaders";
import Section from "./section.astro";
import { Separator } from "./ui/separator";
import {
  IconWorld,
  IconBrandGithub,
  IconBrandLinkedin,
} from "@tabler/icons-react";
import { SummaryParagraph } from "./summary-paragraph";

const { data: infos } = await getInfos();

const list = [infos.address, infos.nationality, infos.visa].join(" | ");

function formatLinkLabel(label: string) {
  return `Go to ${label}`;
}
---

<aside class="order-0 border-s border-mist-300 bg-mist-50 md:order-[unset]">
  <div class="@container sticky top-0 flex flex-col gap-y-6 p-6 text-sm">
    <header class="md:hidden">
      <h1 class="text-3xl font-bold">{infos.full_name}</h1>
      <h2 class="text-xl font-semibold">{infos.position}</h2>
    </header>
    <Section label="Information" class="flex flex-col gap-y-1">
      <span>
        <a href={`tel:${infos.phone_number}`}>{infos.phone_number}</a>
        |
        <a href={`mailto:${infos.email}`}>{infos.email}</a>
      </span>
      <span>{list}</span>
    </Section>
    <Section label="Summary">
      <SummaryParagraph client:idle text={infos.summary} />
    </Section>
    <Separator />
    <div
      class="flex flex-col items-center justify-between gap-y-2 text-xs @2xs:flex-row"
    >
      <span>
        @ {new Date().getFullYear()}
        {infos.full_name}
      </span>
      <ul class="flex gap-x-1">
        {
          infos.links.map((link) => (
            <li>
              <a
                target="_blank"
                href={link.href}
                title={formatLinkLabel(link.label)}
                aria-label={formatLinkLabel(link.label)}
              >
                {link.label === "GitHub" ? (
                  <IconBrandGithub className="size-5" />
                ) : link.label === "LinkedIn" ? (
                  <IconBrandLinkedin className="size-5" />
                ) : (
                  <IconWorld className="size-5" />
                )}
                <span class="sr-only">{formatLinkLabel(link.label)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</aside>

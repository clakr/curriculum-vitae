---
import { getInfos } from "@/lib/loaders";
import Section from "./section.astro";
import { Separator } from "./ui/separator";
import {
  IconWorld,
  IconBrandGithub,
  IconBrandLinkedin,
} from "@tabler/icons-react";
import { SummaryParagraph } from "./summary-paragraph";
import DarkModeButton from "./dark-mode-button.astro";
import { buildFullName, cn } from "@/lib/utils";
import { RequestPDFDialog } from "./request-pdf-dialog";

const { data: info } = await getInfos();

const list = [info.address, info.nationality, info.visa].join(" | ");

function formatLinkLabel(label: string) {
  return `Go to ${label}`;
}

const fullName = buildFullName({
  first_name: info.first_name,
  last_name: info.last_name,
  middle_name: info.middle_name,
});
---

<aside
  class={cn(
    "order-0 border-s border-mist-400/75 bg-mist-50",
    "md:order-[unset]",
    "dark:bg-mist-900 dark:border-mist-600/75",
  )}
>
  <div class="@container sticky top-0 flex flex-col gap-y-6 p-6 text-sm">
    <header class="md:hidden">
      <h2 class="text-3xl font-bold">{fullName}</h2>
      <h3 class="text-xl font-semibold">{info.position}</h3>
    </header>
    <Section label="Information" class="flex flex-col gap-y-1">
      <span>
        <a href={`tel:${info.phone_number}`}>{info.phone_number}</a>
        |
        <a href={`mailto:${info.email}`}>{info.email}</a>
      </span>
      <span>{list}</span>
    </Section>
    <Section label="Summary">
      <SummaryParagraph client:idle text={info.summary} />
    </Section>
    <Separator />
    <div
      class="flex flex-col items-center justify-between gap-y-2 text-xs @2xs:flex-row"
    >
      <span>
        @ {new Date().getFullYear()}
        {fullName}
      </span>
      <div class="flex gap-x-2">
        {
          info.links.map((link) => (
            <a
              target="_blank"
              href={link.href}
              title={formatLinkLabel(link.label)}
              aria-label={formatLinkLabel(link.label)}
            >
              {link.label === "GitHub" ? (
                <IconBrandGithub className="size-5" />
              ) : link.label === "LinkedIn" ? (
                <IconBrandLinkedin className="size-5" />
              ) : (
                <IconWorld className="size-5" />
              )}
              <span class="sr-only">{formatLinkLabel(link.label)}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="fixed right-4 bottom-4 flex flex-col-reverse gap-y-0">
      <DarkModeButton />
      <RequestPDFDialog client:idle />
    </div>
  </div>
</aside>

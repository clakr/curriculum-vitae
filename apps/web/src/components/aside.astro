---
import Section from "./section.astro";

type Props = {
  phoneNumber: string;
  email: string;
  address: string;
  nationality: string;
  visa: string;
  summary: string;
};

const { phoneNumber, email, address, nationality, visa, summary } = Astro.props;
---

<aside class="border-s border-mist-300 bg-mist-50">
  <div class="sticky top-0 p-4">
    <Section label="Information">
      <span>{phoneNumber} | {email}</span>
      <span>{address} | {nationality} | {visa}</span>
    </Section>
    <Section label="Summary">
      <p>{summary}</p>
    </Section>
  </div>
</aside>
